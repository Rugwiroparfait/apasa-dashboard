# Production template: local development can use APASA_DEBUG=true and localhost hosts.
# Process environment takes precedence; the ignored local .env is loaded automatically.
APASA_DEBUG=false
APASA_SECRET_KEY=
APASA_ALLOWED_HOSTS=apasa.example.org
APASA_CSRF_TRUSTED_ORIGINS=https://apasa.example.org
APASA_TRUST_PROXY=true
# Set production passwords securely before provision_accounts; no defaults in production.
APASA_POLICYMAKER_PASSWORD=
APASA_DISTRICT_PASSWORD=
# Persistent SQLite for one instance; use PostgreSQL for multiple replicas.
APASA_SQLITE_PATH=/app/runtime/db.sqlite3

# Optional AI wording. Leave unset to use local factual template drafting.
APASA_AI_API_KEY=
APASA_AI_MODEL=gpt-5.4-mini
chat_openai_key=
APASA_AI_ALLOWED_MODELS=gpt-5.4-mini
